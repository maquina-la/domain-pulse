{
  "manifest_version": 3,
  "name": "Domain Pulse - Domain Health & Audit HUD",
  "version": "1.0.1",
  "description": "Audit domain health, DNS routing, SSL security, and web infrastructure directly in Chrome's native Side Panel.",
  "action": {
    "default_title": "Domain Pulse HUD",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.functions.volcano.run/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
